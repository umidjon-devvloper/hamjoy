{
  "expo": {
    "name": "HamJoy",
    "slug": "joymee",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "joymee",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.joymee.app"
    },
    "android": {
      "package": "uz.joymee.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0F2A1C"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4001"
    },
    "icon": "./assets/images/logo.png"
  }
}
