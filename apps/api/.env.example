# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PUBLIC_URL=https://cdn.example.com   # or https://pub-<hash>.r2.dev

ESKIZ_EMAIL=
