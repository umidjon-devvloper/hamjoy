NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://joymee:joymee@localhost:5432/joymee
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=joymee-dev-master-key

JWT_ACCESS_SECRET=change-me-min-16-characters
JWT_REFRESH_SECRET=change-me-min-16-characters-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=joymee-media
S3_ACCESS_KEY=joymee
S3_SECRET_KEY=joymee-secret
